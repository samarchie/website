{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
